# Servidor HTTP
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8100,http://localhost:4200,capacitor://localhost,http://localhost

# Base de datos PostgreSQL 18 + PostGIS (local)
DB_HOST=localhost
